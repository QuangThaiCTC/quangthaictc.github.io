---
import PageLayout from '@/layouts/CommonPage.astro'
import ToolSection from '@/components/about/ToolSection.astro'
---

<PageLayout title='Tools'>
  {/* tools */}
  <h2></h2>
  <ToolSection
    class='mb-5'
    title='Pentesting'
    tools={[
      {
        name: 'Burp Suite',
        description: 'Standard Web Testing Tool',
        href: 'https://portswigger.net/burp/communitydownload',
        icon: import('@/assets/tools/burpsuite.svg?raw')
      },
      {
        name: 'Cyber Chef',
        description: 'I will temporarily call it a versatile encryption and decryption tool',
        href: 'https://gchq.github.io/CyberChef/',
        icon: import('@/assets/tools/cyberchef.svg?raw')
      },
      {
        name: 'ExploitDB',
        description: 'Repository for storing information and techniques for exploiting security vulnerabilities',
        href: 'https://www.exploit-db.com/',
        icon: import('@/assets/tools/exploitdb.svg?raw')
      },
      {
        name: 'GTFOBins',
        description: 'A list of Unix binaries that can be exploited to bypass local security restrictions',
        href: 'https://gtfobins.org/',
        icon: import('@/assets/tools/gtfobins.svg?raw')
      },
      {
        name: 'Metasploit',
        description: 'Automated exploit development tool but requires some advanced techniques',
        href: 'https://www.metasploit.com/download',
        icon: import('@/assets/tools/metasploit.svg?raw')
      },
      {
        name: 'Nmap',
        description: 'Tool for collecting information about targets',
        href: 'https://nmap.org/download',
        icon: import('@/assets/tools/nmap.svg?raw')
      }
    ]}
  />
  <ToolSection
  class='mb-5'
  title='Coding'
  tools={[
      {
        name: 'VS Code',
        description: 'My main code editor',
        href: 'https://code.visualstudio.com/download',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Neovim',
        description: 'I am currently learning to use and set up with LazyVim',
        href: 'https://neovim.io/doc/install/',
        icon: import('@/assets/tools/neovim.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Operating Systems'
    tools={[
      {
        name: 'CachyOS',
        description: 'My main operating system for daily tasks and learning security',
        href: 'https://cachyos.org/download/',
        icon: import('@/assets/tools/cachyos.svg?raw')
      },
      {
        name: 'Kali Linux',
        description: 'The most popular Linux distribution for penetration testing and security research',
        href: 'https://www.kali.org/get-kali/',
        icon: import('@/assets/tools/kalilinux.svg?raw')
      },
      {
        name: 'Windows 10',
        description: 'I use it to practice Windows-related techniques and for tasks that require a Windows environment',
        href: 'https://www.microsoft.com/en-us/software-download/windows10ISO',
        icon: import('@/assets/tools/windows10.svg?raw')
      },
      {
        name: 'WMWare Workstation Pro',
        description: 'Virtualization platform, the pro version is now free.',
        href: 'https://support.broadcom.com/group/ecx/productdownloads?subfamily=VMware%20Workstation%20Pro&freeDownloads=true',
        icon: import('@/assets/tools/vmware.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Other Tools'
    tools={[
      {
        name: 'Chrome',
        description: 'This browser I often use for web vulnerability exploitation',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Firefox',
        description: 'This browser I often use for web vulnerability exploitation',
        href: 'https://www.mozilla.org/en-US/firefox',
        icon: import('@/assets/tools/firefox.svg?raw')
      },
      {
        name: 'Obsidian',
        description: 'This is a note-taking and knowledge management tool',
        href: 'https://obsidian.md/download',
        icon: import('@/assets/tools/obsidian.svg?raw')
      },
      {
        name: 'ONLYOFFICE',
        description: 'This is a document editing tool similar to Microsoft Word',
        href: 'https://www.onlyoffice.com/download-desktop',
        icon: import('@/assets/tools/onlyoffice.svg?raw')
      }
    ]}
  />
</PageLayout>
